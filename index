        const badge=document.createElement('span');
        badge.className='timeline-count ltr';
        badge.textContent='+'+(dateCounts[m.date]-1);
        thumb.appendChild(badge);
      }
      const meta=document.createElement('div');
      meta.className='timeline-meta';
      meta.innerHTML=`<div class="timeline-date ltr">Chapter ${String(i+1).padStart(2,'0')}</div><div class="timeline-title">${line}</div>`;
      item.appendChild(thumb); item.appendChild(meta);
      item.addEventListener('click',()=>{
        const photosOfDay=APP_CONFIG.photos.filter(p=>p.date===m.date);
        LightboxEngine.open(photosOfDay,0,item);
      });
      track.appendChild(item);
    });

    if('IntersectionObserver' in window){
      const io=new IntersectionObserver(entries=>{
        entries.forEach(entry=>{
          entry.target.classList.toggle('is-active',entry.isIntersecting);
        });
      },{root:AppState.isMobile?null:track,threshold:.6});
      Utils.qsa('.timeline-item',track).forEach(el=>io.observe(el));
    }

    // rule fill on scene visibility
    const rule=Utils.qs('#timelineRuleFill');
    if('IntersectionObserver' in window && rule){
      const io2=new IntersectionObserver(entries=>{
        entries.forEach(e=>{ if(e.isIntersecting) rule.style.width='100%'; });
      },{threshold:.4});
      io2.observe(Utils.qs('#scene-03'));
    }
  }
  return {build};
})();

