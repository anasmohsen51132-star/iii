/* ============================================================================
   MODAL MANAGER
   ============================================================================ */
const ModalManager=(()=>{
  const root=Utils.qs('#modalRoot');
  const panel=Utils.qs('#modalPanel');
  const titleEl=Utils.qs('#modalTitle');
  const bodyEl=Utils.qs('#modalBody');
  const backdrop=Utils.qs('#modalBackdrop');
  const closeBtn=Utils.qs('#modalClose');
  let lastFocused=null;

  function trapFocus(e){
    if(e.key!=='Tab') return;
    const focusables=Utils.qsa('button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])',panel);
    if(!focusables.length) return;
    const first=focusables[0], last=focusables[focusables.length-1];
    if(e.shiftKey && document.activeElement===first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement===last){ e.preventDefault(); first.focus(); }
  }
  function open({title,html}){
    lastFocused=document.activeElement;
    titleEl.textContent=title||'';
    bodyEl.innerHTML=html||'';
    root.style.display='flex';
    void root.offsetWidth; // commit the display change on its own frame so the opacity
                            // transition below actually animates from 0, and so closeBtn
                            // is genuinely focusable (not display:none) before we focus it
    root.classList.add('is-open');
    AppState.modalOpen=true;
    document.body.classList.add('lock-scroll');
    closeBtn.focus();
    document.addEventListener('keydown',onKey);
  }
  function close(){
    root.classList.remove('is-open');
    AppState.modalOpen=false;
    document.body.classList.remove('lock-scroll');
    document.removeEventListener('keydown',onKey);
    if(lastFocused) lastFocused.focus();
    setTimeout(()=>{ if(!AppState.modalOpen) root.style.display='none'; },420);
  }
  function onKey(e){
    if(e.key==='Escape') close();
    trapFocus(e);
  }
  function init(){
    closeBtn.addEventListener('click',close);
    backdrop.addEventListener('click',close);
  }
  return {init,open,close};
})();

/* ============================================================================
   LIGHTBOX ENGINE
   ============================================================================ */
const LightboxEngine=(()=>{
  const root=Utils.qs('#lightbox');
  const imgEl=Utils.qs('#lightboxImg');
  const captionEl=Utils.qs('#lightboxCaption');
  const counterEl=Utils.qs('#lightboxCounter');
  const prevBtn=Utils.qs('#lightboxPrev');
  const nextBtn=Utils.qs('#lightboxNext');
  const closeBtn=Utils.qs('#lightboxClose');
  let list=[],index=0,lastFocused=null,touchStartX=null;

  function preload(i){
    if(i<0||i>=list.length) return;
    const im=new Image(); im.src=ImageLoader.src(list[i].file);
  }
  function render(){
    const item=list[index];
    const line=APP_CONFIG.loveLines[index%APP_CONFIG.loveLines.length];
    imgEl.classList.remove('is-shown');
    const nextSrc=ImageLoader.src(item.file);
    const temp=new Image();
    temp.onload=()=>{
      imgEl.src=nextSrc;
      imgEl.alt=line;
      requestAnimationFrame(()=>imgEl.classList.add('is-shown'));
    };
    temp.onerror=()=>{ imgEl.alt='Image unavailable right now'; };
    temp.src=nextSrc;
    captionEl.textContent=line;
    counterEl.textContent=String(index+1).padStart(2,'0')+' / '+String(list.length).padStart(2,'0');
    preload(index-1); preload(index+1);
  }
  function open(photoList,startIndex,triggerEl){
    list=photoList; index=startIndex;
    lastFocused=triggerEl||document.activeElement;
    root.style.display='flex';
    void root.offsetWidth; // see ModalManager.open for why this matters
    root.classList.add('is-open');
    AppState.lightboxOpen=true;
    document.body.classList.add('lock-scroll');
    render();
    closeBtn.focus();
  }
  function close(){
    root.classList.remove('is-open');
    AppState.lightboxOpen=false;
    document.body.classList.remove('lock-scroll');
    if(lastFocused) lastFocused.focus();
    setTimeout(()=>{ if(!AppState.lightboxOpen) root.style.display='none'; },520);
  }
  function next(){ index=(index+1)%list.length; render(); }
  function prev(){ index=(index-1+list.length)%list.length; render(); }

  let lastTapTime=0;
  function handleLikeTap(e){
    const now=Date.now();
    const x=e.clientX||(e.changedTouches&&e.changedTouches[0].clientX)||window.innerWidth/2;
    const y=e.clientY||(e.changedTouches&&e.changedTouches[0].clientY)||window.innerHeight/2;
    if(now-lastTapTime<380){
      HeartBurstEngine.pop(x,y);
      HeartBurstEngine.burst(x,y,7);
      if(navigator.vibrate) navigator.vibrate(14);
      lastTapTime=0;
    }else{
      lastTapTime=now;
    }
  }
  function init(){
    closeBtn.addEventListener('click',close);
    nextBtn.addEventListener('click',next);
    prevBtn.addEventListener('click',prev);
    imgEl.addEventListener('click',handleLikeTap);
    document.addEventListener('keydown',e=>{
      if(!AppState.lightboxOpen) return;
      if(e.key==='Escape') close();
      else if(e.key==='ArrowRight') next();
      else if(e.key==='ArrowLeft') prev();
    });
    root.addEventListener('touchstart',e=>{ touchStartX=e.touches[0].clientX; },{passive:true});
    root.addEventListener('touchend',e=>{
      if(touchStartX===null) return;
      const dx=e.changedTouches[0].clientX-touchStartX;
      if(Math.abs(dx)>50){ dx<0?next():prev(); }
      touchStartX=null;
    },{passive:true});
  }
  return {init,open,close};
})();

