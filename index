/* ============================================================================
   ERROR HANDLING — errors are logged, the core experience never breaks
   ============================================================================ */
const ErrorHandling=(()=>{
  function init(){
    window.addEventListener('error',e=>{ console.warn('[Injty] recovered from error:',e.message); });
    window.addEventListener('unhandledrejection',e=>{ console.warn('[Injty] recovered from rejection:',e.reason); });
  }
  function safe(fn,label){
    try{ return fn(); }catch(err){ console.warn('[Injty] safe() caught in',label,err); }
  }
  function attachImageFallback(img,label){
    img.addEventListener('error',()=>{
      const holder=document.createElement('div');
      holder.className='img-fallback';
      holder.textContent=label||'Image unavailable right now';
      if(img.parentElement){ img.parentElement.replaceChild(holder,img); }
    },{once:true});
  }
  return {init,safe,attachImageFallback};
})();

/* ============================================================================
   TOAST ENGINE
   ============================================================================ */
const ToastEngine=(()=>{
  const container=Utils.qs('#toastContainer');
  function show(msg,duration=3200){
    const el=document.createElement('div');
    el.className='toast';
    el.textContent=msg;
    container.appendChild(el);
    requestAnimationFrame(()=>el.classList.add('is-visible'));
    setTimeout(()=>{
      el.classList.remove('is-visible');
      setTimeout(()=>el.remove(),450);
    },duration);
  }
  return {show};
})();

/* ============================================================================
   TEXT ANIMATION ENGINE — reveal / type, fully cancellable
   ============================================================================ */
const TextAnimationEngine=(()=>{
  function revealWords(el,text,opts={}){
    el.innerHTML='';
    const words=text.split(' ');
    words.forEach((w,i)=>{
      const span=document.createElement('span');
      span.className='reveal-word';
      span.textContent=w+(i<words.length-1?'\u00A0':'');
      span.style.transitionDelay=(i*(opts.stagger||35))+'ms';
      el.appendChild(span);
    });
    let cancelled=false;
    requestAnimationFrame(()=>{
      if(cancelled) return;
      Utils.qsa('.reveal-word',el).forEach(s=>s.classList.add('is-visible'));
    });
    return {cancel(){ cancelled=true; }};
  }

  function typeText(el,text,opts={}){
    const speed=AppState.reducedMotion?0:(opts.speed||24);
    let i=0,timer=null,paused=false,cancelled=false;
    const cursor=opts.cursorEl;
    function step(){
      if(cancelled) return;
      if(paused){ timer=setTimeout(step,80); return; }
      if(i<=text.length){
        el.textContent=text.slice(0,i);
        if(cursor) el.appendChild(cursor);
        i++;
        timer=setTimeout(step,speed);
      }else if(opts.onDone){ opts.onDone(); }
    }
    if(speed===0){ el.textContent=text; if(opts.onDone) opts.onDone(); }
    else step();
    return {
      pause(){ paused=true; },
      resume(){ paused=false; },
      cancel(){ cancelled=true; clearTimeout(timer); },
      skip(){ cancelled=true; clearTimeout(timer); el.textContent=text; if(cursor) el.appendChild(cursor); if(opts.onDone) opts.onDone(); }
    };
  }
  return {revealWords,typeText};
})();

/* ============================================================================
   SCROLL REVEAL ENGINE — general IntersectionObserver for [data-reveal] elements
   ============================================================================ */
const ScrollRevealEngine=(()=>{
  function init(){
    const els=Utils.qsa('[data-reveal]');
    if(!('IntersectionObserver' in window)){
      els.forEach(el=>el.classList.add('is-visible'));
      return;
    }
    const io=new IntersectionObserver((entries)=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting){
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -12% 0px'});
    els.forEach(el=>io.observe(el));
  }
  return {init};
})();

/* ============================================================================
   IMAGE LOADER — sets data-loaded and shows a fallback on failure
   ============================================================================ */
const ImageLoader=(()=>{
  function bind(img,label){
    img.addEventListener('load',()=>{ img.dataset.loaded='1'; },{once:true});
    ErrorHandling.attachImageFallback(img,label);
  }
  function src(file){ return 'images/'+file; }
  return {bind,src};
})();

/* ============================================================================
   PRELOADER ENGINE — loads the actual critical images and shows real progress
   ============================================================================ */
const PreloaderEngine=(()=>{
  let done=false, total=0, loaded=0;
  const introFill=Utils.qs('#introLoadingFill');
  const preloaderFill=Utils.qs('#preloaderFill');
  const introLoading=Utils.qs('#introLoading');
  function updateBars(){
    const pct=total?Math.round((loaded/total)*100):100;
    if(introFill) introFill.style.width=pct+'%';
    if(preloaderFill) preloaderFill.style.width=pct+'%';
  }
  function preloadCritical(onDone){
    const critical=[
      ImageLoader.src(APP_CONFIG.heroPhoto),
      ImageLoader.src(APP_CONFIG.firstMemoryPhoto),
      ...APP_CONFIG.memories.slice(0,3).map(m=>ImageLoader.src(m.cover))
    ];
    total=critical.length; loaded=0;
    if(introLoading) introLoading.classList.add('is-visible');
    if(total===0){ done=true; onDone && onDone(); return; }
    critical.forEach(src=>{
      const img=new Image();
      img.onload=img.onerror=()=>{
        loaded++; updateBars();
        if(loaded>=total){ done=true; onDone && onDone(); }
      };
      img.src=src;
    });
    // safety timeout so a slow/broken asset never blocks the experience
    setTimeout(()=>{ if(!done){ done=true; onDone && onDone(); } },6000);
  }
  function isDone(){ return done; }
  return {preloadCritical,isDone};
})();

