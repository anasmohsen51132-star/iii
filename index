            const body=Utils.qs('#letterBody');
            const cursor=Utils.qs('#letterCursor');
            controller=TextAnimationEngine.typeText(body,APP_CONFIG.letter,{
              speed:20, cursorEl:cursor,
              onDone(){
                sign.classList.add('is-visible');
                const r=sign.getBoundingClientRect();
                HeartBurstEngine.burst(r.left+r.width/2,r.top,8);
              }
            });
            io.disconnect();
          }
        });
      },{threshold:.3});
      io.observe(Utils.qs('#scene-08'));
    }
  }
  return {init};
})();

/* ============================================================================
   QUESTION ENGINE (Scene 09)
   ============================================================================ */
const QuestionEngine=(()=>{
  function build(){
    Utils.qs('#questionText').textContent=APP_CONFIG.question.text;
    const wrap=Utils.qs('#questionAnswers');
    const responseEl=Utils.qs('#questionResponse');
    const continueBtn=Utils.qs('#questionContinue');
    APP_CONFIG.question.answers.forEach(a=>{
      const btn=document.createElement('button');
      btn.className='q-answer'; btn.type='button'; btn.textContent=a.label;
      btn.addEventListener('click',()=>{
        Utils.qsa('.q-answer',wrap).forEach(b=>b.classList.remove('is-chosen'));
        btn.classList.add('is-chosen');
        responseEl.textContent=a.response;
        requestAnimationFrame(()=>responseEl.classList.add('is-visible'));
        continueBtn.classList.add('is-visible');
      });
      wrap.appendChild(btn);
    });
    continueBtn.addEventListener('click',()=>{
      const next=Utils.qs('#scene-10');
      next.scrollIntoView({behavior:AppState.reducedMotion?'auto':'smooth'});
    });
  }
  return {build};
})();

/* ============================================================================
   FINAL SCENE ENGINE (Scene 10)
   ============================================================================ */
const FinalSceneEngine=(()=>{
  let played=false;
  function play(){
    if(played) return; played=true;
    document.body.classList.add('final-mode');
    AudioController.duck();
    const linesWrap=Utils.qs('#finalLines');
    APP_CONFIG.finalLines.forEach((t,i)=>{
      const p=document.createElement('p');
      p.className='final-line'; p.textContent=t;
      linesWrap.appendChild(p);
      setTimeout(()=>p.classList.add('is-visible'),i*1100);
    });
    const afterLines=APP_CONFIG.finalLines.length*1100+600;
    setTimeout(()=>{
      const namesEl=Utils.qs('#finalNames');
      namesEl.innerHTML=`<span>${APP_CONFIG.person.herName}</span><span class="amp">&#10084;</span><span>${APP_CONFIG.person.myName}</span>`;
      namesEl.classList.add('is-visible');
      const r=namesEl.getBoundingClientRect();
      HeartBurstEngine.burst(r.left+r.width/2,r.top+r.height/2,14);
    },afterLines);
    setTimeout(()=>{
      const msg=Utils.qs('#finalMessage');
      msg.textContent=APP_CONFIG.finalMessage;
      msg.classList.add('is-visible');
    },afterLines+900);
    setTimeout(()=>{
      Utils.qs('#finalRestart').classList.add('is-visible');
    },afterLines+1600);
  }
  function init(){
    Utils.qs('#finalRestart').addEventListener('click',()=>{
      document.body.classList.remove('final-mode');
      AudioController.unduck();
      window.scrollTo({top:0,behavior:AppState.reducedMotion?'auto':'smooth'});
      ToastEngine.show('Back to the beginning of the story 🤍');
    });
    if('IntersectionObserver' in window){
      const io=new IntersectionObserver(entries=>{
        entries.forEach(e=>{ if(e.isIntersecting) play(); });
      },{threshold:.5});
      io.observe(Utils.qs('#scene-10'));
    }
  }
  return {init};
})();

/* ============================================================================
   AUDIO CONTROLLER
   ============================================================================ */
const AudioController=(()=>{
  const audio=Utils.qs('#bgAudio');
  const btn=Utils.qs('#audioToggle');
  let available=true, fadeRaf=null, duckedVolume=false;

  function fadeTo(target,duration=800){
    cancelAnimationFrame(fadeRaf);
    const start=audio.volume, t0=performance.now();
    function step(now){
      const t=Utils.clamp((now-t0)/duration,0,1);
      audio.volume=Utils.lerp(start,target,t);
      if(t<1) fadeRaf=requestAnimationFrame(step);
    }
    fadeRaf=requestAnimationFrame(step);
  }
  function setState(state){
    AppState.audioState=state;
    btn.classList.toggle('is-playing',state==='playing');
    btn.setAttribute('aria-pressed',state==='playing'?'true':'false');
    btn.setAttribute('aria-label',state==='playing'?'Pause music':'Play music');
    StorageService.set('musicPref',state);
  }
  function play(){
    if(!available) return;
    audio.volume=0;
    audio.play().then(()=>{ fadeTo(APP_CONFIG.audio.volume); setState('playing'); })
      .catch(()=>{ setState('off'); });
  }
  function pause(){ fadeTo(0,500); setTimeout(()=>audio.pause(),520); setState('paused'); }
  function toggle(){ AppState.audioState==='playing'?pause():play(); }
  function duck(){ if(AppState.audioState==='playing' && !duckedVolume){ duckedVolume=true; fadeTo(APP_CONFIG.audio.volume*.35,1200); } }
  function unduck(){ if(duckedVolume){ duckedVolume=false; fadeTo(APP_CONFIG.audio.volume,1200); } }

  function init(){
    if(!APP_CONFIG.audio.enabled){ btn.style.display='none'; return; }

    const sources=Array.isArray(APP_CONFIG.audio.sources)
      ? APP_CONFIG.audio.sources
      : [APP_CONFIG.audio.source].filter(Boolean);
    let sourceIndex=0;

    const tryNextSource=()=>{
      if(sourceIndex>=sources.length){
        available=false;
        btn.style.display='none';
        console.warn('[Injty] no supported audio source found — controls hidden gracefully');
        return;
      }
      audio.src=sources[sourceIndex++];
      audio.load();
    };

    audio.addEventListener('error',()=>{
      tryNextSource();
    });

    audio.addEventListener('loadedmetadata',()=>{
      available=true;
    });

    tryNextSource();
    btn.addEventListener('click',toggle);
  }
  return {init,play,pause,toggle,duck,unduck};
})();

/* ============================================================================
   SCENE MANAGER + NAVIGATION ENGINE
   ============================================================================ */
const SceneManager=(()=>{
  const scenes=Utils.qsa('.scene');
  const dotsWrap=Utils.qs('#sceneDots');
  const countEl=Utils.qs('#progressCount');
  const lineEl=Utils.qs('#progressLine');
  const labelEl=Utils.qs('#progressLabel');

  function buildNav(){
    scenes.forEach((s,i)=>{
      const dot=document.createElement('button');
      dot.className='scene-dot'+(i===0?' is-active':'');
      dot.type='button';
      dot.dataset.label=s.dataset.sceneLabel||('Scene '+(i+1));
      dot.setAttribute('aria-label','Go to '+dot.dataset.label);
      dot.addEventListener('click',()=>{
        s.scrollIntoView({behavior:AppState.reducedMotion?'auto':'smooth'});
      });
      dotsWrap.appendChild(dot);
    });
  }
  function setActive(i){
    AppState.currentScene=i;
    countEl.textContent=String(i+1).padStart(2,'0')+' / '+String(scenes.length).padStart(2,'0');
    if(labelEl) labelEl.textContent=scenes[i].dataset.sceneLabel||'';
    lineEl.style.width=Math.round(((i+1)/scenes.length)*100)+'%';
    Utils.qsa('.scene-dot',dotsWrap).forEach((d,di)=>d.classList.toggle('is-active',di===i));
  }
  function init(){
    buildNav();
    if('IntersectionObserver' in window){
      // a thin horizontal band near the vertical center of the viewport acts as
      // the "scrollspy" line — robust regardless of how tall a given scene is
      const io=new IntersectionObserver(entries=>{
        entries.forEach(entry=>{
          if(entry.isIntersecting){
            const idx=scenes.indexOf(entry.target);
            if(idx>-1) setActive(idx);
          }
        });
      },{threshold:0,rootMargin:'-45% 0px -45% 0px'});
      scenes.forEach(s=>io.observe(s));
    }
  }
  return {init};
})();

/* ============================================================================
   EASTER EGG ENGINE
   ============================================================================ */
const EasterEggEngine=(()=>{
  function initTripleClick(){
    const target=Utils.qs('#heroTitle');
    if(!target) return;
    let count=0,timer=null;
    target.addEventListener('click',()=>{
      count++;
      clearTimeout(timer);
      timer=setTimeout(()=>{ count=0; },600);
      if(count===3){ count=0; ToastEngine.show(APP_CONFIG.easterEggs.tripleClickMessage); }
    });
  }
  function initKeySequence(){
    const seq=['ArrowUp','ArrowUp','ArrowDown','ArrowDown'];
    let pos=0;
    document.addEventListener('keydown',e=>{
      if(e.key===seq[pos]){ pos++; if(pos===seq.length){ pos=0; ToastEngine.show(APP_CONFIG.easterEggs.keySequenceMessage); } }
      else{ pos=(e.key===seq[0])?1:0; }
    });
  }
  function initLongPress(){
    const target=Utils.qs('#hiddenStar');
    let pressTimer=null;
    const start=()=>{ pressTimer=setTimeout(()=>ToastEngine.show(APP_CONFIG.easterEggs.longPressMessage),850); };
    const cancel=()=>clearTimeout(pressTimer);
    target.addEventListener('pointerdown',start);
    ['pointerup','pointerleave','pointercancel'].forEach(ev=>target.addEventListener(ev,cancel));
    target.addEventListener('click',e=>{
      if(e.detail===0) return; // avoid double firing with long press
    });
  }
  function initHiddenStar(){
    const star=Utils.qs('#hiddenStar');
    star.addEventListener('click',()=>{ ToastEngine.show(APP_CONFIG.easterEggs.starMessage); });
  }
  function init(){
    initTripleClick(); initKeySequence(); initLongPress(); initHiddenStar();
  }
  return {init};
})();

/* ============================================================================
   ACCESSIBILITY ENGINE
   ============================================================================ */
const AccessibilityEngine=(()=>{
  function init(){
    document.documentElement.classList.toggle('reduced-motion',AppState.reducedMotion);
    if(window.matchMedia){
      window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change',e=>{
        AppState.reducedMotion=e.matches;
        document.documentElement.classList.toggle('reduced-motion',e.matches);
      });
    }
  }
  return {init};
})();

/* ============================================================================
   DEBUG ENGINE
   ============================================================================ */
const DebugEngine=(()=>{
  let overlay,frames=0,lastT=performance.now(),fps=0;
  function loop(){
    frames++;
    const now=performance.now();
    if(now-lastT>=500){ fps=Math.round((frames*1000)/(now-lastT)); frames=0; lastT=now; }
    overlay.textContent=
`SCENE     ${AppState.currentScene+1}/${AppState.totalScenes}
FPS       ${fps}
IMAGES    ${AppState.loadedImages}
AUDIO     ${AppState.audioState}
TOUCH     ${AppState.isTouch}
MOBILE    ${AppState.isMobile}
REDUCED   ${AppState.reducedMotion}`;
    requestAnimationFrame(loop);
  }
  function init(){
    if(!APP_CONFIG.debug) return;
    overlay=Utils.qs('#debugOverlay');
    overlay.classList.add('is-active');
    loop();
  }
  return {init};
})();

