/* ============================================================================
   PARTICLE ENGINE — subtle, canvas-based, tab-aware
   ============================================================================ */
const ParticleEngine=(()=>{
  const canvas=Utils.qs('#particleCanvas');
  const ctx=canvas.getContext('2d');
  let particles=[],raf,w,h;
  function resize(){
    w=canvas.width=window.innerWidth;
    h=canvas.height=window.innerHeight*Math.max(2,document.body.scrollHeight/window.innerHeight);
  }
  function heartPath(size){
    // returns an SVG-ish path drawn via canvas commands, centered at 0,0
    const p=new Path2D();
    p.moveTo(0,size*0.32);
    p.bezierCurveTo(0,-size*0.2,-size,-size*0.2,-size,size*0.28);
    p.bezierCurveTo(-size,size*0.72,-size*0.4,size*0.95,0,size*1.32);
    p.bezierCurveTo(size*0.4,size*0.95,size,size*0.72,size,size*0.28);
    p.bezierCurveTo(size,-size*0.2,0,-size*0.2,0,size*0.32);
    return p;
  }
  function makeParticles(){
    const base=AppState.isMobile?26:34;
    const count=AppState.reducedMotion?0:base;
    particles=Array.from({length:count},()=>({
      x:Math.random()*w, y:Math.random()*h,
      r:Math.random()*5+2.5,
      vy:-(Math.random()*.14+.035),
      vx:(Math.random()-.5)*.05,
      rot:(Math.random()-.5)*.6,
      vr:(Math.random()-.5)*.0006,
      o:Math.random()*.4+.12,
      isHeart:Math.random()<.4
    }));
  }
  function loop(){
    if(document.hidden){ raf=requestAnimationFrame(loop); return; }
    ctx.clearRect(0,0,w,h);
    const scrollY=window.scrollY;
    ctx.fillStyle=APP_CONFIG.visual.accent;
    particles.forEach(p=>{
      p.x+=p.vx; p.y+=p.vy; p.rot+=p.vr;
      if(p.y<scrollY-20){ p.y=scrollY+(window.innerHeight); p.x=Math.random()*w; }
      ctx.globalAlpha=p.o;
      if(p.isHeart){
        ctx.save();
        ctx.translate(p.x,p.y-scrollY);
        ctx.rotate(p.rot);
        ctx.fill(heartPath(p.r));
        ctx.restore();
      }else{
        ctx.beginPath();
        ctx.arc(p.x,p.y-scrollY,p.r*.28,0,Math.PI*2);
        ctx.fill();
      }
    });
    ctx.globalAlpha=1;
    raf=requestAnimationFrame(loop);
  }
  function init(){
    if(AppState.reducedMotion) return;
    resize(); makeParticles(); loop();
    window.addEventListener('resize',Utils.debounce(()=>{ resize(); makeParticles(); },300));
  }
  return {init};
})();

/* ============================================================================
   HEART BURST ENGINE — tiny love-driven micro-interactions
   ============================================================================ */
const HeartBurstEngine=(()=>{
  let layer=null;
  function ensureLayer(){
    if(!layer){
      layer=document.createElement('div');
      layer.id='heartBurstLayer';
      layer.setAttribute('aria-hidden','true');
      document.body.appendChild(layer);
    }
    return layer;
  }
  function burst(x,y,count=8){
    if(AppState.reducedMotion) return;
    const l=ensureLayer();
    for(let i=0;i<count;i++){
      const h=document.createElement('span');
      h.className='heart-burst-particle';
      h.textContent='♥';
      const angle=Math.random()*Math.PI*2;
      const dist=40+Math.random()*100;
      const dx=Math.cos(angle)*dist;
      const dy=Math.sin(angle)*dist-70-Math.random()*50;
      h.style.left=x+'px'; h.style.top=y+'px';
      h.style.color=Math.random()<.5?'var(--rose-bright)':'var(--gold-bright)';
      h.style.fontSize=(11+Math.random()*13)+'px';
      h.style.setProperty('--dx',dx+'px');
      h.style.setProperty('--dy',dy+'px');
      h.style.setProperty('--rot',(Math.random()*60-30)+'deg');
      h.style.setProperty('--sc',(.6+Math.random()*.9).toFixed(2));
      l.appendChild(h);
      h.addEventListener('animationend',()=>h.remove());
    }
  }
  function pop(x,y){
    if(AppState.reducedMotion) return;
    const l=ensureLayer();
    const h=document.createElement('div');
    h.className='heart-pop';
    h.textContent='♥';
    h.style.left=x+'px'; h.style.top=y+'px';
    l.appendChild(h);
    h.addEventListener('animationend',()=>h.remove());
  }
  return {burst,pop};
})();

